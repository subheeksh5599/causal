# No secrets here. Copy to .env and fill in. .env is gitignored and never printed.

# ---- mode ------------------------------------------------------------------
# LOCAL (default) | LIVE | TWIN
CAUSAL_MODE=LOCAL
CAUSAL_TIMEZONE=Europe/London

# ---- Google (Gmail = authority for approval; Calendar = the scheduling effect)
# GOCSPX- secrets and refresh tokens are obtained through scripts/google_oauth.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---- Linear (the work effect) ----------------------------------------------
# key:  linear.app/settings/api     team id: printed by the first GraphQL query
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# ---- Slack (optional fourth app; not used by the three-app flagship) --------
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ---- Twin-backed services (TWIN mode: stateful replicas, no OAuth) ---------
# The twin endpoints are per-session; TWIN_API_KEY is the account key.
TWIN_API_KEY=
TWIN_BASE_URL=
TWIN_API_URL=
